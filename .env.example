# Browser-visible values embedded by Vite at build time.
# Required Google APIs: Maps JavaScript API, Places API (New), and
# Places UI Kit API. If this key is API-restricted, allow all three.
VITE_GOOGLE_MAPS_API_KEY=your_restricted_browser_key
VITE_GOOGLE_MAP_ID=your_google_map_id
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
